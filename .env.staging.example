# ============================================================
# FOX AI AGENCY — Staging Environment Template
# ============================================================
# Copy to .env.staging and fill in staging values.
# This file is used by docker-compose.staging.yml.
# Staging should NOT use production credentials.
# ============================================================

NODE_ENV=staging
PORT=3000
FOX_INTERNAL_PORT=3000
FOX_LISTEN_HOST=0.0.0.0

# Firebase (staging project — never use production here)
GOOGLE_CLOUD_PROJECT=fox-ai-agency-staging
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Security (generate a separate staging key)
FOX_SECRET_KEY=

# AI providers (staging keys)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Public URL (staging domain)
FOX_PUBLIC_BASE_URL=https://staging.fox-ai-agency.example.com

# Integrations (all disabled by default — enable explicitly)
ENABLE_TELEGRAM=false
ENABLE_META=false
ENABLE_SMTP=false
ENABLE_EXTERNAL_CRM=false
ENABLE_N8N=false
