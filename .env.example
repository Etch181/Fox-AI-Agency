# ============================================================
# FOX AI AGENCY — ENVIRONMENT EXAMPLE
# ============================================================

NODE_ENV=production
PORT=3000

# Public HTTPS URL of this FOX deployment.
# Example:
# FOX_PUBLIC_BASE_URL=https://fox.example.com
FOX_PUBLIC_BASE_URL=

# Firebase
GOOGLE_CLOUD_PROJECT=

# Recommended for generic hosting / VPS / Hostinger / Render.
# Paste the complete Firebase service-account JSON as one env value.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Optional Google-hosted fallback:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# FOX encryption / secret vault
FOX_SECRET_KEY=

# AI Providers
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# FOX Agency main Telegram bot.
# Tenant bot tokens are NOT stored here.
TELEGRAM_BOT_TOKEN=
