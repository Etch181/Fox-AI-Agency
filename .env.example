# ============================================================
# FOX AI AGENCY — ENVIRONMENT EXAMPLE
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.
# ============================================================

# ---- APP ----
NODE_ENV=production
# Internal port the Node app listens on (behind Nginx reverse proxy).
PORT=3000
# Optional override for the internal listen port (VPS staging uses this).
FOX_INTERNAL_PORT=3000
# Bind address for the Node server. Use 127.0.0.1 behind Nginx.
# Set to 0.0.0.0 only if exposing directly (not recommended).
FOX_LISTEN_HOST=127.0.0.1

# ---- FIREBASE ----
# GCP project ID
GOOGLE_CLOUD_PROJECT=
# Firebase Admin service-account JSON (preferred for VPS).
# Paste the entire JSON as a single-line string.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
# Optional Google-hosted fallback for ADC.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# ---- SECURITY ----
# AES-256-GCM secret key for workspace secret vault encryption.
# Generate with: openssl rand -base64 32
FOX_SECRET_KEY=

# ---- AI PROVIDERS ----
# At least one is REQUIRED for AI functionality.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=  # Optional, not currently used at runtime

# ---- TELEGRAM ----
# FOX Agency main bot token (for onboarding, registration, agency-level interaction).
# Tenant bot tokens are stored encrypted in Firestore, never here.
TELEGRAM_BOT_TOKEN=
# Enable Telegram integration. Defaults to false (fail-safe).
ENABLE_TELEGRAM=false

# ---- META (Facebook/Instagram) ----
# Page access token for Meta integrations.
META_PAGE_ACCESS_TOKEN=
# Webhook verify token for Meta webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# Enable Meta integration. Defaults to false (fail-safe).
ENABLE_META=false

# ---- SMTP / EMAIL ----
# SMTP host for verification emails.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Enable SMTP integration. Defaults to false (fail-safe).
ENABLE_SMTP=false

# ---- EXTERNAL INTEGRATIONS ----
# Enable external CRM webhook delivery. Defaults to false (fail-safe).
ENABLE_EXTERNAL_CRM=false

# ---- N8N ----
# Enable n8n webhook simulation/proxy endpoint. Defaults to false (fail-safe).
ENABLE_N8N=false

# ---- PUBLIC URL ----
# The public HTTPS URL of this FOX deployment (used for webhook callbacks).
# Example: https://fox.example.com
FOX_PUBLIC_BASE_URL=
# Legacy/alternate names (checked as fallback):
# PUBLIC_BASE_URL=
# APP_URL=
