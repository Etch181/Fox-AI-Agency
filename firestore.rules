rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // FOX AI AGENCY — PRODUCTION FIRESTORE RULES V1
    // ========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function role() {
      return hasUserProfile()
        ? userDoc().data.role
        : null;
    }

    function userWorkspaceId() {
      return hasUserProfile()
        ? userDoc().data.workspaceId
        : null;
    }

    function isSuperAdmin() {
      return signedIn() &&
        role() == "super_admin";
    }

    function hasSupportedTenantRole() {
      return signedIn() &&
        (
          role() == "client_owner" ||
          role() == "staff"
        );
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() &&
        (
          isSuperAdmin() ||
          (
            hasSupportedTenantRole() &&
            userWorkspaceId() == workspaceId &&
            exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)
            ) &&
            (
              get(
                /databases/$(database)/documents/workspaces/$(workspaceId)
              ).data.keys().hasAny(["status"]) == false ||
              get(
                /databases/$(database)/documents/workspaces/$(workspaceId)
              ).data.status != "deleted"
            )
          )
        );
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn() &&
        role() == "client_owner" &&
        userWorkspaceId() == workspaceId &&
        (
          !resource.data.keys().hasAny(["status"]) ||
          resource.data.status != "deleted"
        ) &&
        resource.data.ownerUid == request.auth.uid;
    }

    function hasWorkspaceId(data) {
      return data.workspaceId is string &&
        data.workspaceId.size() > 0;
    }

    function canAccessWorkspaceId(workspaceId) {
      return isWorkspaceMember(workspaceId);
    }

    function canManageOwnerOnlyWorkspaceData(workspaceId) {
      return signedIn() &&
        (
          isSuperAdmin() ||
          (
            role() == "client_owner" &&
            userWorkspaceId() == workspaceId &&
            exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)
            ) &&
            get(
              /databases/$(database)/documents/workspaces/$(workspaceId)
            ).data.ownerUid == request.auth.uid &&
            (
              get(
                /databases/$(database)/documents/workspaces/$(workspaceId)
              ).data.keys().hasAny(["status"]) == false ||
              get(
                /databases/$(database)/documents/workspaces/$(workspaceId)
              ).data.status != "deleted"
            )
          )
        );
    }

    function ownsResource() {
      return hasWorkspaceId(resource.data) &&
        canAccessWorkspaceId(resource.data.workspaceId);
    }

    function ownsNewResource() {
      return hasWorkspaceId(request.resource.data) &&
        canAccessWorkspaceId(request.resource.data.workspaceId);
    }

    function ownsOwnerOnlyResource() {
      return hasWorkspaceId(resource.data) &&
        canManageOwnerOnlyWorkspaceData(resource.data.workspaceId);
    }

    function ownsNewOwnerOnlyResource() {
      return hasWorkspaceId(request.resource.data) &&
        canManageOwnerOnlyWorkspaceData(
          request.resource.data.workspaceId
        );
    }

    function keepsWorkspaceId() {
      return request.resource.data.workspaceId ==
        resource.data.workspaceId;
    }

    function containsNoWorkspaceSecrets(data) {
      return !data.keys().hasAny([
        "googleSheetsAccessToken",
        "telegramBotToken",
        "externalCrmWebhookUrl",
        "whatsappAccessToken",
        "whatsappVerifyToken",
        "facebookPageAccessToken",
        "facebookVerifyToken",
        "password",
        "passwordHash",
        "apiKey",
        "encryptedSecret",
        "encryptedPayload",
        "ciphertext",
        "iv",
        "authTag"
      ]);
    }

    function ownsNestedResource(workspaceId) {
      return isWorkspaceMember(workspaceId) &&
        hasWorkspaceId(resource.data) &&
        resource.data.workspaceId == workspaceId;
    }

    function ownsNewNestedResource(workspaceId) {
      return isWorkspaceMember(workspaceId) &&
        hasWorkspaceId(request.resource.data) &&
        request.resource.data.workspaceId == workspaceId;
    }

    function crmLeadBelongsToWorkspace(workspaceId, leadId) {
      return exists(
          /databases/$(database)/documents/workspaces/$(workspaceId)/crmLeads/$(leadId)
        ) &&
        get(
          /databases/$(database)/documents/workspaces/$(workspaceId)/crmLeads/$(leadId)
        ).data.workspaceId == workspaceId;
    }

    function conversationBelongsToWorkspace(
      workspaceId,
      conversationId
    ) {
      return exists(
          /databases/$(database)/documents/workspaces/$(workspaceId)/conversations/$(conversationId)
        ) &&
        get(
          /databases/$(database)/documents/workspaces/$(workspaceId)/conversations/$(conversationId)
        ).data.workspaceId == workspaceId;
    }

    // ========================================================
    // USER PROFILES
    // ========================================================

    match /users/{userId} {
      allow read: if signedIn() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin()
        );

      // Registration profiles are provisioned only by the trusted Admin SDK
      // transaction that also claims the normalized email and phone.
      allow create: if false;

      // Client cannot elevate role or jump between tenants.
      allow update: if signedIn() &&
        (
          isSuperAdmin() ||
          (
            request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.workspaceId == resource.data.workspaceId
          )
        );

      allow delete: if isSuperAdmin();
    }

    // ========================================================
    // WORKSPACES
    // ========================================================

    match /workspaces/{workspaceId} {
      allow read: if canManageOwnerOnlyWorkspaceData(workspaceId) &&
        containsNoWorkspaceSecrets(resource.data);

      // Starter workspaces are created only by the trusted Admin SDK
      // transaction after it acquires unique trial claim documents.
      allow create: if false;

      // Tenant owners can change an explicit set of operational
      // fields. Members and future unknown fields default to deny.
      allow update: if
        (
          isWorkspaceOwner(workspaceId) &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name", "industry", "ownerName", "phone", "aiSettings",
              "telegramBotName", "telegramBotStatus",
              "whatsappBotStatus", "whatsappPhoneNumber",
              "whatsappPhoneNumberId", "whatsappBusinessAccountId",
              "whatsappConnectedAt", "onboardingStatus",
              "onboardingCompleted", "onboardingCompletedAt",
              "onboardingStep", "businessDescription",
              "onboardingAiReady", "onboardingCatalogReady",
              "crmSpreadsheetId"
            ])
        );

      allow delete: if isSuperAdmin();

      // ------------------------------------------------------
      // Explicit workspace-scoped collections.
      // Unknown future collections are denied below.
      // ------------------------------------------------------

      match /crmLeads/{leadId} {
        allow read: if ownsNestedResource(workspaceId);
        allow delete: if ownsNestedResource(workspaceId);
        allow create: if ownsNewNestedResource(workspaceId);
        allow update: if ownsNestedResource(workspaceId) &&
          ownsNewNestedResource(workspaceId) &&
          keepsWorkspaceId();

        // CRM events are authoritative server records.
        match /events/{eventId} {
          allow read: if isWorkspaceMember(workspaceId) &&
            crmLeadBelongsToWorkspace(workspaceId, leadId);
          allow create, update, delete: if false;
        }
      }

      match /appointments/{appointmentId} {
        allow read: if ownsNestedResource(workspaceId);
        allow delete: if ownsNestedResource(workspaceId);
        allow create: if ownsNewNestedResource(workspaceId);
        allow update: if ownsNestedResource(workspaceId) &&
          ownsNewNestedResource(workspaceId) &&
          keepsWorkspaceId();
      }

      match /conversations/{conversationId} {
        allow read: if ownsNestedResource(workspaceId);
        allow create, delete: if false;

        // Browser clients only clear unread state. Conversation
        // content and routing remain server-authoritative.
        allow update: if ownsNestedResource(workspaceId) &&
          ownsNewNestedResource(workspaceId) &&
          keepsWorkspaceId() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["unreadCount", "updatedAt"]) &&
          request.resource.data.unreadCount is int &&
          request.resource.data.unreadCount >= 0 &&
          request.resource.data.updatedAt is string;

        match /messages/{messageId} {
          allow read: if isWorkspaceMember(workspaceId) &&
            conversationBelongsToWorkspace(
              workspaceId,
              conversationId
            );
          allow create, update, delete: if false;
        }
      }

      // These records are written by the Admin SDK. Tenant users
      // may read selected reporting data but cannot forge it.
      match /couponRedemptions/{redemptionId} {
        allow read: if ownsNestedResource(workspaceId);
        allow create, update, delete: if false;
      }

      match /usage/{usageId} {
        allow read: if ownsNestedResource(workspaceId);
        allow create, update, delete: if false;
      }

      // Shared AI memory is server-only and may contain private
      // conversation context.
      match /shared_memory/{memoryId} {
        allow read, write: if false;
      }

      match /{unknownCollection}/{document=**} {
        allow read, write: if false;
      }
    }

    // ========================================================
    // TENANT DATA COLLECTIONS
    // Documents must contain workspaceId.
    // ========================================================

    match /crmLeads/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /appointments/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /menuItems/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /medicines/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /products/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /productOrders/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /complaints/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /knowledgeFacts/{docId} {
      allow read, delete: if ownsOwnerOnlyResource();
      allow create: if ownsNewOwnerOnlyResource();
      allow update: if ownsOwnerOnlyResource() &&
        ownsNewOwnerOnlyResource() &&
        keepsWorkspaceId();
    }

    match /coupons/{docId} {
      allow read, delete: if ownsOwnerOnlyResource();
      allow create: if ownsNewOwnerOnlyResource();
      allow update: if ownsOwnerOnlyResource() &&
        ownsNewOwnerOnlyResource() &&
        keepsWorkspaceId();
    }

    match /supportTickets/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /serviceRatings/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /courses/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /doctors/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /clinicServices/{docId} {
      allow read, delete: if ownsResource();
      allow create: if ownsNewResource();
      allow update: if ownsResource() &&
        ownsNewResource() &&
        keepsWorkspaceId();
    }

    match /n8nWorkflows/{docId} {
      allow read, delete: if ownsOwnerOnlyResource();
      allow create: if ownsNewOwnerOnlyResource();
      allow update: if ownsOwnerOnlyResource() &&
        ownsNewOwnerOnlyResource() &&
        keepsWorkspaceId();
    }

    match /marketing_generated_posts/{docId} {
      allow read, delete: if ownsOwnerOnlyResource();
      allow create: if ownsNewOwnerOnlyResource();
      allow update: if ownsOwnerOnlyResource() &&
        ownsNewOwnerOnlyResource() &&
        keepsWorkspaceId();
    }

    // ========================================================
    // PAYMENTS
    // ========================================================

    match /payments/{paymentId} {

      // Billing submissions are owner-only; Super Admin sees all.
      allow read: if hasWorkspaceId(resource.data) &&
        canManageOwnerOnlyWorkspaceData(resource.data.workspaceId);

      // Submission and transitions are authoritative server-only.
      allow create, update, delete: if false;
    }

    match /paymentReferences/{referenceId} {
      allow read, write: if false;
    }

    // ========================================================
    // AI MODEL ANALYTICS
    // ========================================================

    match /aiModelUsage/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /aiModelHealth/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ========================================================
    // AGENCY-ONLY DATA
    // ========================================================

    match /activationCodes/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /audit_logs/{docId} {
      allow read: if isSuperAdmin();

      // Current browser audit creation is used only by the Super
      // Admin screens. New records bind the actor to Firebase Auth.
      allow create: if isSuperAdmin() &&
        request.resource.data.id == docId &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == "super_admin" &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.actorName == userDoc().data.name &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.action is string &&
        request.resource.data.category is string &&
        request.resource.data.severity is string &&
        request.resource.data.target is string &&
        request.resource.data.details is string;

      // Audit history is append-only for all browser clients.
      allow update, delete: if false;
    }

    match /gemini_metrics/{workspaceId} {
      allow read: if isSuperAdmin() ||
        (
          hasWorkspaceId(resource.data) &&
          canManageOwnerOnlyWorkspaceData(resource.data.workspaceId)
        );

      // The existing diagnostic dashboard persists metrics from a
      // verified Super Admin session. Normal tenants are read-only.
      allow create: if isSuperAdmin() &&
        request.resource.data.workspaceId == workspaceId;

      allow update: if isSuperAdmin() &&
        resource.data.workspaceId == workspaceId &&
        request.resource.data.workspaceId ==
          resource.data.workspaceId;

      allow delete: if false;
    }

    // ========================================================
    // SECRET VAULT
    // ========================================================
    //
    // Browser access is completely forbidden.
    // Firebase Admin SDK on the server bypasses Firestore rules.
    // ========================================================

    match /workspaceSecrets/{workspaceId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ========================================================
    // DEFAULT DENY
    // ========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
