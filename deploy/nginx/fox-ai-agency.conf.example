# ============================================================
# FOX AI AGENCY — Nginx Reverse Proxy Template
# ============================================================
# Place this at: deploy/nginx/fox-ai-agency.conf.example
# Copy to /etc/nginx/sites-available/ or /etc/nginx/conf.d/
# and symlink accordingly.
# ============================================================

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name fox-ai-agency.ai.studio;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

# HTTPS reverse proxy → FOX Node app
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name fox-ai-agency.ai.studio;

    # --- SSL Configuration ---
    # Obtain certificates via Let's Encrypt (certbot):
    #   certbot certonly --standalone -d fox-ai-agency.ai.studio
    ssl_certificate /etc/letsencrypt/live/fox-ai-agency.ai.studio/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fox-ai-agency.ai.studio/privkey.pem;

    # Hardened SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # --- Security Headers ---
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'" always;

    # --- Request size limit ---
    client_max_body_size 50m;

    # --- Proxy headers ---
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # --- Proxy timeouts ---
    proxy_connect_timeout 30s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    send_timeout 30s;

    # --- WebSocket upgrade support ---
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # --- Main FOX AI AGENCY application ---
    # Node app listens on 127.0.0.1:3000 (FOX_INTERNAL_PORT)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect off;
    }

    # --- Static asset caching ---
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect off;
        proxy_cache_valid 200 24h;
        add_header Cache-Control "public, max-age=86400";
    }

    # --- Health check endpoint (no auth required) ---
    # Used by load balancer / monitoring
    location /api/health {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect off;
        access_log off;
    }

    # --- Telegram webhook (must be publicly accessible for webhook mode) ---
    # Only enable if Telegram integration is active and webhooks are configured
    location /api/telegram/webhook/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect off;
        # Telegram requires longer timeout for webhook processing
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # --- Meta webhook (Facebook/Instagram) ---
    location /api/webhooks/meta-social {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect off;
    }
}
