# Copy to .env on the VPS and chmod 600. Never commit the populated file.
N8N_HOST=n8n-staging.foxaiagency.online
GENERIC_TIMEZONE=Africa/Cairo
TRAEFIK_NETWORK=REPLACE_WITH_EXISTING_TRAEFIK_NETWORK
FOX_STAGING_NETWORK=REPLACE_WITH_EXISTING_FOX_STAGING_NETWORK
TRAEFIK_CERT_RESOLVER=letsencrypt
FOX_INTERNAL_BASE_URL=http://fox-ai-staging:3000
N8N_ENCRYPTION_KEY=GENERATE_A_RANDOM_32_BYTE_OR_LONGER_VALUE
